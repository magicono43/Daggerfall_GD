extends RefCounted
const Configuration = preload("res://scripts/input/binding_configuration.gd")
const Events = preload("res://tests/action_input_cases.gd")
const Actions = preload("res://scripts/input/action_input.gd")
const Settings = preload("res://scripts/startup/settings_owner.gd")
var checks: Array[Dictionary] = []
var events := Events.new()
class RejectingConsumer extends RefCounted:
	var reject := false
	func can_configure(_candidate: Dictionary) -> bool: return not reject
	func configure(_candidate: Dictionary) -> bool: return not reject

func check(label: String, passed: bool) -> void:
	checks.append({"scenario":label,"expected":true,"actual":passed})
	if not passed: push_error("Binding configuration: " + label)

func inject(event: InputEvent) -> void:
	Input.parse_input_event(event)
	Input.flush_buffered_events()

func press(shell: Control, prefix: String) -> void:
	var button := events.find_button(shell,prefix)
	if button == null: push_error("Missing stock button: " + prefix)
	else: button.pressed.emit()

func flush(shell: Control) -> void:
	shell.render()
	await shell.get_tree().process_frame
	await shell.get_tree().process_frame

func run(shell: Control, fixture: Dictionary) -> Dictionary:
	var owner: RefCounted = shell.controller.controls
	var settings: StartupSettingsOwner = shell.controller.settings
	var stock: RefCounted = shell.session_shell
	shell.controller.route = "main_menu"
	stock.core.provider = preload("res://tests/controlled_session_provider.gd").new()
	stock.synchronize_startup()
	stock.request("new")
	shell.render()
	await flush(shell)
	check("isolated controls storage",settings.path.begins_with(str(fixture.sandbox)))
	check("packaged complete configuration valid",Configuration.valid(Configuration.defaults()))
	check("inventory contains deliberate unbound Slide",owner.effective().actions.has("slide") and owner.effective().actions.slide.keyboard == [{},{}])
	check("all actions expose two independent families and slots",Configuration.inventory().all(func(action: String): return owner.effective().actions[action].keyboard.size() == 2 and owner.effective().actions[action].controller.size() == 2))
	stock.pause()
	await flush(shell)
	press(shell,"Settings")
	await flush(shell)
	press(shell,"Controls")
	await flush(shell)
	var editor: RefCounted = stock.binding_editor
	check("actual stock Controls opens private draft",stock.windows.top().window == "controls" and owner.draft() == owner.effective() and not stock.core.gates.gameplay_input())
	var detached: Dictionary = owner.draft()
	detached.actions.jump.keyboard[0] = {}
	check("draft projection detached",not owner.draft().actions.jump.keyboard[0].is_empty())
	press(shell,"Clear keyboard 1")
	await flush(shell)
	check("actual Clear stages deliberate unbound",owner.draft().actions.jump.keyboard[0].is_empty() and not owner.effective().actions.jump.keyboard[0].is_empty())
	press(shell,"Reset This Action")
	await flush(shell)
	check("actual Reset This Action stages defaults",owner.draft().actions.jump == Configuration.defaults().actions.jump)
	# Wait for the opening mouse input, including modifiers, before assignment.
	stock.action_input.observe(events.mouse(MOUSE_BUTTON_LEFT,true))
	press(shell,"Keyboard 2")
	await flush(shell)
	inject(events.key(KEY_E,true))
	inject(events.key(KEY_E,false))
	check("opening input blocks capture",not editor.capture.is_empty() and owner.draft().actions.jump.keyboard[1].is_empty())
	inject(events.mouse(MOUSE_BUTTON_LEFT,false))
	inject(events.key(KEY_E,true))
	inject(events.key(KEY_E,false))
	await flush(shell)
	check("stock capture assigns fresh physical key",editor.capture.is_empty() and owner.draft().actions.jump.keyboard[1].code == KEY_E)
	check("capture preserves effective map",owner.effective().actions.jump.keyboard[1].is_empty())
	press(shell,"Keyboard 2")
	await flush(shell)
	inject(events.key(KEY_ESCAPE,true))
	inject(events.key(KEY_ESCAPE,false))
	await flush(shell)
	check("Escape cancels capture without clearing or closing",editor.capture.is_empty() and owner.draft().actions.jump.keyboard[1].code == KEY_E and stock.windows.top().window == "controls")
	stock.action_input.observe(events.mouse(MOUSE_BUTTON_LEFT,true))
	press(shell,"Keyboard 2")
	await flush(shell)
	inject(InputEventMouseMotion.new())
	check("mouse motion ignored by capture",not editor.capture.is_empty())
	inject(events.axis(JOY_AXIS_LEFT_X,0.03))
	check("stick drift cannot bind discrete slot",not editor.capture.is_empty())
	inject(events.button(JOY_BUTTON_START,true,98))
	inject(events.button(JOY_BUTTON_START,false,98))
	inject(events.mouse(MOUSE_BUTTON_LEFT,false))
	await flush(shell)
	check("unselected Start exits capture to controls",editor.capture.is_empty() and stock.windows.top().window == "controls")
	check("reserved Escape rejected",not owner.propose("jump","keyboard",1,{"kind":"key","code":KEY_ESCAPE}).ok)
	check("reserved Start rejected",not owner.propose("jump","controller",1,{"kind":"button","code":JOY_BUTTON_START}).ok)
	check("controller combinations unsupported",not owner.propose("jump","controller",1,{"kind":"button","code":JOY_BUTTON_X,"modifier":"x"}).ok)
	check("side-less modifier rejected",not owner.propose("jump","keyboard",1,{"kind":"key","code":KEY_SHIFT}).ok)
	check("unsupported mouse rejected",not owner.propose("jump","keyboard",1,{"kind":"mouse","code":99}).ok)
	check("unsupported axis rejected",not owner.propose("jump","controller",1,{"kind":"trigger","code":JOY_AXIS_LEFT_X}).ok)
	var before: Dictionary = owner.draft()
	owner.propose("attack","keyboard",1,{"kind":"key","code":KEY_E})
	await flush(shell)
	check("same-context conflict leaves draft unchanged",not owner.pending().is_empty() and owner.draft() == before)
	press(shell,"Cancel Assignment")
	await flush(shell)
	check("actual conflict Cancel retains draft",owner.pending().is_empty() and owner.draft() == before)
	owner.propose("attack","keyboard",1,{"kind":"key","code":KEY_E})
	await flush(shell)
	press(shell,"Replace")
	await flush(shell)
	check("actual Replace clears visible victim",owner.draft().actions.jump.keyboard[1].is_empty() and owner.draft().actions.attack.keyboard[1].code == KEY_E)
	var keyboard: Array = owner.draft().actions.attack.keyboard.duplicate(true)
	owner.propose("attack","controller",1,{"kind":"trigger","code":JOY_AXIS_TRIGGER_RIGHT})
	check("controller slot independent from keyboard family",owner.draft().actions.attack.keyboard == keyboard and owner.draft().actions.attack.controller[1].kind == "trigger")
	check("mutually exclusive UI context can reuse gameplay button",owner.propose("ui_confirm","controller",1,{"kind":"button","code":3}).ok)
	check("UI same-context collision rejected",not owner.propose("ui_back","controller",1,{"kind":"button","code":3}).ok)
	owner.resolve_replace(false)
	var shift := "%d:%d" % [KEY_SHIFT,KEY_LOCATION_LEFT]
	var ctrl := "%d:%d" % [KEY_CTRL,KEY_LOCATION_RIGHT]
	check("plain plus chord intentional precedence",owner.propose("activate","keyboard",1,{"kind":"key","code":KEY_E,"modifier":shift}).ok)
	check("simultaneously eligible distinct chords require resolution",not owner.propose("jump","keyboard",1,{"kind":"key","code":KEY_E,"modifier":ctrl}).ok)
	owner.resolve_replace(false)
	check("modifier mouse chord supported",owner.propose("jump","keyboard",1,{"kind":"mouse","code":MOUSE_BUTTON_XBUTTON1,"modifier":ctrl}).ok)
	check("invalid deadzone rejects entire analog edit",not owner.set_analog({"look_deadzone":1.0}).ok and owner.draft().analog.look_deadzone == 0.10)
	check("overlapping axis pairs rejected",not owner.set_analog({"movement_pair":1}).ok)
	await flush(shell)
	for child in shell.panel.get_children():
		if child is OptionButton and child.get_item_text(0).begins_with("Movement Pair"):
			child.select(1)
			child.item_selected.emit(1)
	await flush(shell)
	for child in shell.panel.get_children():
		if child is SpinBox and child.prefix.begins_with("Movement Deadzone"): child.value = 0.2
		if child is SpinBox and child.prefix.begins_with("Look Deadzone"): child.value = 0.12
		if child is CheckBox and child.text.begins_with("Look Invert"): child.button_pressed = true
	check("distinct axis pairs and deadzones stage",owner.draft().analog == {"movement_pair":1,"look_pair":0,"movement_deadzone":0.2,"look_deadzone":0.12,"movement_invert":false,"look_invert":true} and owner.effective().analog == Configuration.defaults().analog)
	var persisted: String = FileAccess.get_file_as_string(settings.path)
	settings.adapter.faults.settings_stage = true
	press(shell,"Apply Controls")
	await flush(shell)
	check("stock Apply publishes effective controls despite disk failure",owner.effective() == owner.draft() and settings.effective[Configuration.SETTING] == owner.draft())
	check("failed save leaves disk unchanged",FileAccess.get_file_as_string(settings.path) == persisted and settings.value(settings.persisted,Configuration.SETTING) != owner.effective())
	check("stock failure feedback truthful and retry reachable","UNSAVED" in owner.status and events.find_button(shell,"Retry Save Controls") != null)
	check("effective analog values applied independently",stock.action_input.movement_deadzone == 0.2 and stock.action_input.look_deadzone == 0.12)
	var reloaded := Settings.new(settings.adapter,settings.path.get_base_dir())
	var recreated := Configuration.new()
	recreated.declare_settings(reloaded)
	check("reload before retry sees persisted old values",reloaded.initialize().ok and reloaded.effective[Configuration.SETTING] != owner.effective())
	recreated.dispose()
	settings.adapter.faults.clear()
	press(shell,"Retry Save Controls")
	await flush(shell)
	check("stock retry saves effective values","saved" in owner.status and settings.value(settings.persisted,Configuration.SETTING) == owner.effective())
	var live_before: Dictionary = owner.effective()
	owner.propose("attack","keyboard",1,{})
	press(shell,"Cancel / Close Controls")
	await flush(shell)
	check("stock close discards unapplied draft",owner.draft().is_empty() and owner.effective() == live_before)
	stock.open_controls()
	await flush(shell)
	owner.propose("jump","keyboard",0,{})
	owner.propose("jump","keyboard",1,{})
	press(shell,"Apply Controls")
	await flush(shell)
	check("intentional unbound applied and persisted",owner.effective().actions.jump.keyboard == [{},{}] and settings.value(settings.persisted,Configuration.SETTING).actions.jump.keyboard == [{},{}])
	var replacement := Actions.new(stock.core,stock.windows)
	check("recreated input consumer receives effective controls",owner.attach(replacement) and replacement.bindings.resolve("key",KEY_E,0,[]) == "attack" and replacement.bindings.resolve("key",KEY_SPACE,0,[]) == "")
	owner.detach(replacement)
	replacement.dispose()
	owner.propose("attack","keyboard",1,{"kind":"key","code":KEY_SPACE})
	owner.reset_action("jump")
	check("per-action reset cannot steal custom assignment",not owner.pending().is_empty() and owner.draft().actions.jump.keyboard[0].is_empty())
	owner.resolve_replace(false)
	press(shell,"Reset All Controls")
	await flush(shell)
	check("stock Reset All staged only",owner.draft() == Configuration.defaults() and owner.effective() != Configuration.defaults())
	press(shell,"Cancel / Close Controls")
	await flush(shell)
	# Published map must select a chord once at main-down and never replay a hold.
	while not stock.windows.top().is_empty(): stock.windows.close(stock.windows.top().id,true)
	var delivered: Array = []
	var callback := func(edge: Dictionary): delivered.append(edge)
	stock.gameplay_edge.connect(callback)
	inject(events.key(KEY_SHIFT,true,KEY_LOCATION_LEFT))
	inject(events.key(KEY_E,true))
	await shell.get_tree().physics_frame
	inject(events.key(KEY_SHIFT,false,KEY_LOCATION_LEFT))
	await shell.get_tree().physics_frame
	check("published chord suppresses plain key through modifier release",delivered.any(func(edge: Dictionary): return edge.action == "activate" and edge.kind == "started") and not delivered.any(func(edge: Dictionary): return edge.action == "attack"))
	stock.open_controls()
	await flush(shell)
	press(shell,"Apply Controls")
	await flush(shell)
	press(shell,"Cancel / Close Controls")
	await flush(shell)
	inject(events.key(KEY_E,false))
	await shell.get_tree().physics_frame
	check("held key across Apply close cancels without deliberate release",not delivered.any(func(edge: Dictionary): return edge.action == "activate" and edge.kind == "released"))
	stock.gameplay_edge.disconnect(callback)
	# Upgrade preserves explicit empties, valid customized entries and unknowns.
	var upgrade: Dictionary = owner.effective()
	upgrade.actions.erase("spellbook")
	upgrade.actions.attack.keyboard[1] = {"kind":"key","code":KEY_F}
	upgrade.actions.future_action = {"opaque":42}
	upgrade.future_field = "preserve"
	var upgraded: Dictionary = owner.upgrade(upgrade)
	check("conflicting new default leaves action unbound",upgraded.actions.spellbook.keyboard == [{},{}] and upgraded.actions.attack.keyboard[1].code == KEY_F)
	check("new-action conflict notice identifies action",owner.notices.any(func(notice: String): return "spellbook" in notice))
	check("compatible upgrade preserves unbound and unknown entries",upgraded.actions.jump.keyboard == [{},{}] and upgraded.actions.future_action.opaque == 42 and upgraded.future_field == "preserve")
	upgrade.actions.attack.keyboard[1] = {"kind":"key","code":KEY_E}
	upgraded = owner.upgrade(upgrade)
	check("conflict-free new action receives default",upgraded.actions.spellbook.keyboard[0].code == KEY_F)
	var invalid: Dictionary = owner.effective()
	invalid.actions.attack.keyboard[1] = {"kind":"key","code":KEY_ESCAPE}
	var effective_before: Dictionary = owner.effective()
	var outcome: Dictionary = settings.apply({Configuration.SETTING:invalid},owner._publish)
	check("whole candidate rejection retains effective and accepted controls",not outcome.ok and owner.effective() == effective_before and settings.effective[Configuration.SETTING] == effective_before)
	owner.begin()
	owner.propose("slide","keyboard",0,{"kind":"key","code":KEY_P})
	var rejector := RejectingConsumer.new()
	owner.attach(rejector)
	rejector.reject = true
	var rejected: Dictionary = owner.apply()
	check("consumer rejection preserves coherent previous controls",not rejected.applied and owner.effective() == effective_before and settings.effective[Configuration.SETTING] == effective_before and "rejected" in owner.status)
	owner.detach(rejector)
	owner.cancel()
	var damaged: Dictionary = effective_before.duplicate(true)
	damaged.actions.jump.keyboard[0] = {"kind":"key","code":KEY_ESCAPE}
	var repaired: Dictionary = owner.upgrade_settings(damaged)
	check("individual invalid action recovery preserves valid custom actions",Configuration.valid(repaired.value) and repaired.value.actions.attack == effective_before.actions.attack and repaired.resets.has("controls/jump"))
	damaged = effective_before.duplicate(true)
	damaged.analog.look_deadzone = 1.0
	repaired = owner.upgrade_settings(damaged)
	check("analog recovery preserves discrete controls",Configuration.valid(repaired.value) and repaired.value.actions == effective_before.actions and repaired.value.analog == Configuration.defaults().analog)
	var fractional_version := Configuration.defaults()
	fractional_version.version = 1.0
	check("unsupported owner version requires explicit settings recovery",not Configuration.compatible_format({"version":2}) and not Configuration.valid(fractional_version))
	# Actual capture of modifier-only keys, chords, wheel and controller inputs.
	stock.open_controls()
	await flush(shell)
	editor.action = "slide"
	editor.start_capture("keyboard",0)
	inject(events.key(KEY_ALT,true,KEY_LOCATION_RIGHT))
	inject(events.key(KEY_ALT,false,KEY_LOCATION_RIGHT))
	check("capture stores right modifier identity",owner.draft().actions.slide.keyboard[0] == {"kind":"key","code":KEY_ALT,"location":KEY_LOCATION_RIGHT})
	editor.start_capture("keyboard",1)
	inject(events.key(KEY_CTRL,true,KEY_LOCATION_RIGHT))
	inject(events.mouse(MOUSE_BUTTON_WHEEL_UP,true))
	inject(events.key(KEY_CTRL,false,KEY_LOCATION_RIGHT))
	check("capture stores modifier wheel step",owner.draft().actions.slide.keyboard[1].get("modifier") == ctrl and owner.draft().actions.slide.keyboard[1].code == MOUSE_BUTTON_WHEEL_UP)
	stock.action_input.connection_changed(7,true)
	stock.action_input.select_controller(7)
	editor.start_capture("controller",0)
	inject(events.button(JOY_BUTTON_B,true))
	inject(events.button(JOY_BUTTON_B,false))
	check("controller Back cancels capture without clearing",editor.capture.is_empty() and owner.draft().actions.slide.controller[0].is_empty())
	editor.start_capture("controller",0)
	inject(events.button(JOY_BUTTON_LEFT_SHOULDER,true))
	inject(events.button(JOY_BUTTON_LEFT_SHOULDER,false))
	check("selected controller button capture preserves family",owner.draft().actions.slide.controller[0].get("code") == JOY_BUTTON_LEFT_SHOULDER and not owner.draft().actions.slide.keyboard[0].is_empty())
	editor.start_capture("controller",1)
	inject(events.axis(JOY_AXIS_TRIGGER_LEFT,0.54))
	check("trigger capture below press threshold ignored",not editor.capture.is_empty())
	inject(events.axis(JOY_AXIS_TRIGGER_LEFT,0.56))
	inject(events.axis(JOY_AXIS_TRIGGER_LEFT,0.44))
	check("eligible trigger captured discretely",owner.draft().actions.slide.controller[1] == {"kind":"trigger","code":JOY_AXIS_TRIGGER_LEFT})
	stock.close_controls()
	await flush(shell)
	stock.open_controls()
	await flush(shell)
	owner.propose("ui_confirm","controller",0,{"kind":"button","code":JOY_BUTTON_LEFT_SHOULDER})
	owner.propose("ui_confirm","controller",1,{})
	owner.propose("ui_back","controller",0,{"kind":"button","code":JOY_BUTTON_RIGHT_SHOULDER})
	owner.apply()
	var confirmations := [0]
	shell.button("Confirmation Probe",func(): confirmations[0] += 1)
	var probe := events.find_button(shell,"Confirmation Probe")
	probe.grab_focus()
	inject(events.button(JOY_BUTTON_A,true))
	inject(events.button(JOY_BUTTON_A,false))
	check("cleared stock UI Confirm cannot activate focused widget",confirmations[0] == 0)
	inject(events.button(JOY_BUTTON_LEFT_SHOULDER,true))
	inject(events.button(JOY_BUTTON_LEFT_SHOULDER,true))
	inject(events.button(JOY_BUTTON_LEFT_SHOULDER,false))
	check("configured UI Confirm activates focused widget once",confirmations[0] == 1)
	inject(events.button(JOY_BUTTON_B,true))
	inject(events.button(JOY_BUTTON_B,false))
	check("cleared stock Back cannot close controls",stock.windows.top().window == "controls")
	inject(events.button(JOY_BUTTON_RIGHT_SHOULDER,true))
	inject(events.button(JOY_BUTTON_RIGHT_SHOULDER,false))
	check("configured UI Back closes controls",stock.windows.top().get("window") != "controls")
	stock.open_controls()
	await flush(shell)
	editor.start_capture("keyboard",0)
	stock.focus_changed(false)
	check("focus loss cancels capture without assigning",editor.capture.is_empty() and owner.draft().actions.slide.keyboard[0].is_empty())
	stock.focus_changed(true)
	stock.close_controls()
	await flush(shell)
	var modifier_label := Configuration.label({"kind":"key","code":KEY_CTRL,"location":KEY_LOCATION_RIGHT})
	check("layout labels expose explicit modifier side",modifier_label.begins_with("Right "))
	var displayed: int = KEY_E if DisplayServer.get_name() == "headless" else DisplayServer.keyboard_get_keycode_from_physical(KEY_E)
	check("key identity independent of displayed layout label",Configuration.label({"kind":"key","code":KEY_E}) == OS.get_keycode_string(displayed))
	var recovery_directory := str(fixture.sandbox).path_join("controls-recovery")
	DirAccess.make_dir_recursive_absolute(recovery_directory)
	var recovery := Settings.new(settings.adapter,recovery_directory)
	var recovery_controls := Configuration.new()
	recovery_controls.declare_settings(recovery)
	recovery.initialize()
	var recovery_file := recovery.clone(recovery.accepted)
	damaged = owner.effective()
	damaged.actions.slide.keyboard[0] = {"kind":"key","code":KEY_ESCAPE}
	recovery.put(recovery_file,Configuration.SETTING,damaged)
	recovery_file.save(recovery.path)
	var recovered: Dictionary = recovery.initialize()
	check("settings recovery reports damaged action and preserves customs",recovered.ok and recovered.kind == "recovered" and "controls/slide" in recovered.detail and recovery.effective[Configuration.SETTING].actions.attack == damaged.actions.attack)
	var newer := recovery.clone(recovery.accepted)
	var newer_controls: Dictionary = recovery.effective[Configuration.SETTING].duplicate(true)
	newer_controls.version = 2
	recovery.put(newer,Configuration.SETTING,newer_controls)
	newer.save(recovery.path)
	var newer_bytes := FileAccess.get_file_as_bytes(recovery.path)
	check("unsupported binding format left untouched",recovery.initialize().kind == "incompatible" and FileAccess.get_file_as_bytes(recovery.path) == newer_bytes)
	check("explicit reset preserves unsupported binding input",recovery.initialize(true).ok and FileAccess.get_file_as_bytes(recovery.path + ".recovery") == newer_bytes)
	recovery_controls.dispose()
	check("approved later response defaults retained without consumers",owner.effective().response == Configuration.response_defaults())
	# Persist final deliberate unbound state for the runner's fresh process check.
	var final := settings.clone(settings.accepted)
	settings.put(final,"fixture/unknown","retained")
	settings.accepted = final
	settings.save_accepted()
	FileAccess.open(str(fixture.sandbox).path_join("binding-expected.txt"),FileAccess.WRITE).store_string(settings.path)
	stock.open_controls()
	await flush(shell)
	if DisplayServer.get_name() != "headless":
		await RenderingServer.frame_post_draw
		var image := shell.get_viewport().get_texture().get_image()
		check("rendered stock binding editor frame",not image.is_empty())
		image.save_png(str(fixture.sandbox).path_join("binding-editor.png"))
	var started := Time.get_ticks_usec()
	Configuration.validate(owner.effective())
	var validation_usec := Time.get_ticks_usec() - started
	started = Time.get_ticks_usec()
	for index in 1000: owner.resolve_ui("button",JOY_BUTTON_LEFT_SHOULDER)
	var query_usec := Time.get_ticks_usec() - started
	return {"ok":checks.all(func(item: Dictionary): return item.expected == item.actual),"checks":checks,"count":checks.size(),"engine":Engine.get_version_info(),"display":DisplayServer.get_name(),"fixture":fixture.fixture,"observations":{"configuration_validation_usec":validation_usec,"1000_indexed_ui_queries_usec":query_usec},"inputs":{"sequence":"binding-config-v1","devices":"injected, physical qualification deferred"}}
